PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=carrerpilot_db
DB_USER=careerpilot_app
DB_PASSWORD=replace-with-a-strong-database-password

JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: career-assistant provider configuration. Keep these values server-side.
AI_API_KEY=
# AI_MODEL takes precedence when both model variables are set.
AI_MODEL=gpt-6-luna
OPENAI_API_KEY=
# Legacy alias; use AI_MODEL for new deployments.
OPENAI_MODEL=gpt-6-luna
AI_API_URL=https://api.openai.com/v1/responses

# Optional live job search. Leave the credentials blank to use workspace roles only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
